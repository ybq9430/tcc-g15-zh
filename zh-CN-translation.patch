+"""
+风扇曲线编辑器：直接拖动阶梯图上的控制点。
+
+- 拖动竖直边界：调整温度阈值
+- 拖动线段上的圆点：调整该档的风扇百分比
+- 灰色竖线表示当前 GPU / CPU 实测温度，方便对着真实温度调参
+"""
+
+from typing import Optional, Tuple
+
+from PySide6 import QtCore, QtGui, QtWidgets
+
+from GUI.AppColors import Colors
+from GUI.FanCurve import FanCurve, TEMP_MIN, TEMP_MAX
+
+
+class CurveEditorWidget(QtWidgets.QWidget):
+    curveChanged = QtCore.Signal()
+
+    MARGIN_L, MARGIN_R, MARGIN_T, MARGIN_B = 46, 16, 16, 32
+    HIT_RADIUS = 11
+    SPEED_SNAP = 5
+
+    def __init__(self, curve: FanCurve, parent: Optional[QtWidgets.QWidget] = None) -> None:
+        super().__init__(parent)
+        self._curve = curve
+        self._drag: Optional[Tuple[str, int]] = None
+        self._liveTemps: Tuple[Optional[int], Optional[int]] = (None, None)
+        self._hover: Optional[Tuple[str, int]] = None
+        self.setMinimumSize(440, 250)
+        self.setMouseTracking(True)
+        self.setCursor(QtCore.Qt.CrossCursor)
+        self.setToolTip("拖动竖线改温度阈值，拖动圆点改该档转速")
+
+    # ---------- 对外 ----------
+
+    def setCurve(self, curve: FanCurve) -> None:
+        self._curve = curve
+        self.update()
+
+    def curve(self) -> FanCurve:
+        return self._curve
+
+    def setLiveTemps(self, gpu: Optional[int], cpu: Optional[int]) -> None:
+        self._liveTemps = (gpu, cpu)
+        self.update()
+
+    # ---------- 坐标换算 ----------
+
+    def _plotRect(self) -> QtCore.QRectF:
+        return QtCore.QRectF(
+            self.MARGIN_L, self.MARGIN_T,
+            max(1.0, self.width() - self.MARGIN_L - self.MARGIN_R),
+            max(1.0, self.height() - self.MARGIN_T - self.MARGIN_B),
+        )
+
+    def _xForTemp(self, t: float) -> float:
+        r = self._plotRect()
+        return r.left() + (t - TEMP_MIN) / (TEMP_MAX - TEMP_MIN) * r.width()
+
+    def _tempForX(self, x: float) -> float:
+        r = self._plotRect()
+        return TEMP_MIN + (x - r.left()) / r.width() * (TEMP_MAX - TEMP_MIN)
+
+    def _yForSpeed(self, s: float) -> float:
+        r = self._plotRect()
+        return r.bottom() - s / 100.0 * r.height()
+
+    def _speedForY(self, y: float) -> float:
+        r = self._plotRect()
+        return (r.bottom() - y) / r.height() * 100.0
+
+    # ---------- 几何 ----------
+
+    def _segments(self):
+        """[(x起, x止, 转速, 档位索引)]"""
+        eb = self._curve.effectiveBoundaries()
+        speeds = self._curve.speeds
+        out = []
+        for i, spd in enumerate(speeds):
+            t0 = TEMP_MIN if i == 0 else eb[i - 1]
+            t1 = TEMP_MAX if i == len(speeds) - 1 else eb[i]
+            out.append((self._xForTemp(t0), self._xForTemp(t1), spd, i))
+        return out
+
+    def _handles(self):
+        """返回 [(种类, 索引, x, y)]，种类为 'b'(边界) 或 's'(线段)"""
+        out = []
+        segs = self._segments()
+        eb = self._curve.effectiveBoundaries()
+        for i, b in enumerate(eb):
+            x = self._xForTemp(b)
+            y = (self._yForSpeed(segs[i][2]) + self._yForSpeed(segs[i + 1][2])) / 2.0
+            out.append(('b', i, x, y))
+        for x0, x1, spd, i in segs:
+            out.append(('s', i, (x0 + x1) / 2.0, self._yForSpeed(spd)))
+        return out
+
+    def _hitTest(self, pos: QtCore.QPointF):
+        best = None
+        bestDist = self.HIT_RADIUS
+        for kind, idx, x, y in self._handles():
+            d = ((pos.x() - x) ** 2 + (pos.y() - y) ** 2) ** 0.5
+            if d < bestDist:
+                bestDist = d
+                best = (kind, idx)
+        return best
+
+    # ---------- 绘制 ----------
+
+    def paintEvent(self, event) -> None:
+        p = QtGui.QPainter(self)
+        p.setRenderHint(QtGui.QPainter.Antialiasing)
+        r = self._plotRect()
+
+        p.fillRect(self.rect(), QtGui.QColor(Colors.DARK_GREY.value))
+        p.fillRect(r, QtGui.QColor('#171717'))
+
+        font = QtGui.QFont('Microsoft YaHei UI', 8)
+        p.setFont(font)
+
+        # 网格
+        gridPen = QtGui.QPen(QtGui.QColor('#2e2e2e'))
+        gridPen.setWidthF(1.0)
+        p.setPen(gridPen)
+        labelPen = QtGui.QPen(QtGui.QColor(Colors.GREY.value))
+        for t in range(TEMP_MIN, TEMP_MAX + 1, 10):
+            x = self._xForTemp(t)
+            p.setPen(gridPen)
+            p.drawLine(QtCore.QPointF(x, r.top()), QtCore.QPointF(x, r.bottom()))
+            p.setPen(labelPen)
+            p.drawText(QtCore.QRectF(x - 18, r.bottom() + 4, 36, 14),
+                       QtCore.Qt.AlignCenter, f"{t}°")
+        for s in range(0, 101, 20):
+            y = self._yForSpeed(s)
+            p.setPen(gridPen)
+            p.drawLine(QtCore.QPointF(r.left(), y), QtCore.QPointF(r.right(), y))
+            p.setPen(labelPen)
+            p.drawText(QtCore.QRectF(2, y - 8, self.MARGIN_L - 8, 16),
+                       QtCore.Qt.AlignRight | QtCore.Qt.AlignVCenter, f"{s}%")
+
+        # 曲线下方填充
+        segs = self._segments()
+        poly = QtGui.QPolygonF()
+        poly.append(QtCore.QPointF(segs[0][0], r.bottom()))
+        for x0, x1, spd, _ in segs:
+            y = self._yForSpeed(spd)
+            poly.append(QtCore.QPointF(x0, y))
+            poly.append(QtCore.QPointF(x1, y))
+        poly.append(QtCore.QPointF(segs[-1][1], r.bottom()))
+        fill = QtGui.QColor(Colors.BLUE.value)
+        fill.setAlpha(45)
+        p.setPen(QtCore.Qt.NoPen)
+        p.setBrush(fill)
+        p.drawPolygon(poly)
+        p.setBrush(QtCore.Qt.NoBrush)
+
+        # 阶梯线
+        curvePen = QtGui.QPen(QtGui.QColor(Colors.BLUE.value).lighter(160))
+        curvePen.setWidthF(2.0)
+        p.setPen(curvePen)
+        for x0, x1, spd, _ in segs:
+            y = self._yForSpeed(spd)
+            p.drawLine(QtCore.QPointF(x0, y), QtCore.QPointF(x1, y))
+        eb = self._curve.effectiveBoundaries()
+        for i, b in enumerate(eb):
+            x = self._xForTemp(b)
+            p.drawLine(QtCore.QPointF(x, self._yForSpeed(segs[i][2])),
+                       QtCore.QPointF(x, self._yForSpeed(segs[i + 1][2])))
+
+        # 实时温度标记
+        colors = (QtGui.QColor(Colors.GREEN.value), QtGui.QColor(Colors.YELLOW.value))
+        for i, t in enumerate(self._liveTemps):
+            if t is None:
+                continue
+            x = self._xForTemp(max(TEMP_MIN, min(TEMP_MAX, t)))
+            pen = QtGui.QPen(colors[i])
+            pen.setWidthF(1.2)
+            pen.setStyle(QtCore.Qt.DashLine)
+            p.setPen(pen)
+            p.drawLine(QtCore.QPointF(x, r.top()), QtCore.QPointF(x, r.bottom()))
+            p.setPen(QtGui.QPen(colors[i]))
+            label = f"{'GPU' if i == 0 else 'CPU'} {t}°"
+            onLeft = x < r.center().x()
+            labelRect = QtCore.QRectF(x + 4 if onLeft else x - 74,
+                                      r.top() + 2 + i * 14, 70, 14)
+            p.drawText(labelRect, QtCore.Qt.AlignLeft if onLeft else QtCore.Qt.AlignRight, label)
+
+        # 控制点
+        for kind, idx, x, y in self._handles():
+            active = self._hover == (kind, idx)
+            radius = 6.5 if active else 5.0
+            if kind == 'b':
+                p.setPen(QtGui.QPen(QtGui.QColor(Colors.WHITE.value), 1.5))
+                p.setBrush(QtGui.QColor('#2f2f2f'))
+                p.drawEllipse(QtCore.QPointF(x, y), radius, radius)
+                p.setPen(QtGui.QPen(QtGui.QColor(Colors.WHITE.value), 1.5))
+                p.drawLine(QtCore.QPointF(x, y - 4), QtCore.QPointF(x, y + 4))
+            else:
+                p.setPen(QtGui.QPen(QtGui.QColor(Colors.DARK_GREY.value), 1.5))
+                p.setBrush(QtGui.QColor(Colors.BLUE.value).lighter(170))
+                p.drawEllipse(QtCore.QPointF(x, y), radius, radius)
+
+        p.end()
+
+    # ---------- 交互 ----------
+
+    def mousePressEvent(self, event) -> None:
+        if event.button() != QtCore.Qt.LeftButton:
+            return
+        hit = self._hitTest(event.position())
+        if hit is not None:
+            self._drag = hit
+            self._applyDrag(event.position())
+
+    def mouseMoveEvent(self, event) -> None:
+        if self._drag is not None:
+            self._applyDrag(event.position())
+            return
+        hit = self._hitTest(event.position())
+        if hit != self._hover:
+            self._hover = hit
+            self.setCursor(QtCore.Qt.SizeHorCursor if hit and hit[0] == 'b'
+                           else QtCore.Qt.SizeVerCursor if hit else QtCore.Qt.CrossCursor)
+            self.update()
+
+    def mouseReleaseEvent(self, event) -> None:
+        self._drag = None
+
+    def leaveEvent(self, event) -> None:
+        self._hover = None
+        self.update()
+
+    def _applyDrag(self, pos: QtCore.QPointF) -> None:
+        kind, idx = self._drag
+        if kind == 'b':
+            target = int(round(self._tempForX(pos.x())))
+            self._curve.setBoundary(idx, target - self._curve.bias)
+        else:
+            raw = self._speedForY(pos.y())
+            snapped = int(round(raw / self.SPEED_SNAP) * self.SPEED_SNAP)
+            self._curve.setSpeed(idx, snapped)
+        self.update()
+        self.curveChanged.emit()
diff -ruN tcc-g15-master/src/GUI/FanCurve.py zh-src/src/GUI/FanCurve.py
--- tcc-g15-master/src/GUI/FanCurve.py	1970-01-01 09:00:00.000000000 +0900
+++ zh-src/src/GUI/FanCurve.py	2026-11-01 18:36:34.539772400 +0900
@@ -0,0 +1,165 @@
+"""
+风扇曲线数据模型。
+
+曲线是「阶梯型」的：给定 N 个温度边界，把 40~100°C 切成 N+1 段，
+每一段一个固定风扇百分比。语义与上游 SILENT_CURVE 一致：
+
+    boundaries = [82, 87, 91]
+    speeds     = [0, 30, 65, 100]
+
+    temp <  82        -> 0%
+    82 <= temp <  87  -> 30%
+    87 <= temp <  91  -> 65%
+    temp >= 91        -> 100%
+
+额外支持一个「噪音偏移」(bias)：把整条曲线的温度边界统一平移，
+让用户只拖一根「安静 ↔ 凉快」的滑块就能微调整体倾向，而不必改每一档。
+"""
+
+import json
+from typing import List, Optional, Tuple
+
+TEMP_MIN = 40
+TEMP_MAX = 100
+SPEED_MIN = 0
+SPEED_MAX = 100
+MIN_GAP = 2          # 相邻温度边界的最小间隔（°C）
+BIAS_LIMIT = 8       # 噪音偏移的上下限（°C）
+
+DEFAULT_BOUNDARIES = [82, 87, 91]
+DEFAULT_SPEEDS = [0, 30, 65, 100]
+
+
+def _normalizeSequence(values: List[int], lo: int, hi: int, gap: int) -> List[int]:
+    """夹取到 [lo, hi]、保证严格递增且相邻间隔 >= gap。
+
+    先做正向推挤，再做反向修正——只做正向会把末尾顶出上界，
+    例如 [200] 夹成 98 后推挤成 [98, 100, 102]。
+    """
+    out = [max(lo, min(hi, int(v))) for v in values]
+    for i in range(1, len(out)):
+        if out[i] < out[i - 1] + gap:
+            out[i] = out[i - 1] + gap
+    if out and out[-1] > hi:
+        out[-1] = hi
+        for i in range(len(out) - 2, -1, -1):
+            if out[i] > out[i + 1] - gap:
+                out[i] = out[i + 1] - gap
+    return [max(lo, v) for v in out]
+
+
+class FanCurve:
+    def __init__(self, boundaries: Optional[List[int]] = None,
+                 speeds: Optional[List[int]] = None, bias: int = 0) -> None:
+        if boundaries is None:
+            boundaries = list(DEFAULT_BOUNDARIES)
+        if speeds is None:
+            speeds = list(DEFAULT_SPEEDS)
+        self.boundaries: List[int] = [int(b) for b in boundaries]
+        self.speeds: List[int] = [int(s) for s in speeds]
+        self.bias: int = int(bias)
+        if len(self.speeds) != len(self.boundaries) + 1:
+            raise ValueError("speeds 必须比 boundaries 多一个元素")
+        self.normalize()
+
+    # ---------- 构造 ----------
+
+    @classmethod
+    def default(cls) -> "FanCurve":
+        return cls()
+
+    @classmethod
+    def fromJson(cls, raw) -> "FanCurve":
+        """从 QSettings 里取出的 JSON 字符串还原；任何异常都退回默认值"""
+        try:
+            d = json.loads(raw) if isinstance(raw, str) else dict(raw)
+            return cls(d["b"], d["s"], d.get("bias", 0))
+        except Exception:
+            return cls()
+
+    def toJson(self) -> str:
+        return json.dumps({"b": self.boundaries, "s": self.speeds, "bias": self.bias},
+                          ensure_ascii=False)
+
+    def copy(self) -> "FanCurve":
+        return FanCurve(self.boundaries, self.speeds, self.bias)
+
+    # ---------- 规范化 ----------
+
+    def normalize(self) -> None:
+        """把边界夹到合法区间、保证严格递增且间隔达标、转速夹到 0~100"""
+        self.bias = max(-BIAS_LIMIT, min(BIAS_LIMIT, int(self.bias)))
+        self.boundaries = _normalizeSequence(self.boundaries,
+                                            TEMP_MIN + MIN_GAP, TEMP_MAX - MIN_GAP, MIN_GAP)
+        self.speeds = [max(SPEED_MIN, min(SPEED_MAX, int(s))) for s in self.speeds]
+
+    # ---------- 求值 ----------
+
+    def effectiveBoundaries(self) -> List[int]:
+        """叠加噪音偏移后的实际边界。偏移后仍需保持递增，否则逐项兜住。"""
+        return _normalizeSequence([b + self.bias for b in self.boundaries],
+                                  TEMP_MIN + MIN_GAP, TEMP_MAX - MIN_GAP, MIN_GAP)
+
+    def bandIndex(self, temp: Optional[int]) -> int:
+        """温度落在第几档。读不到温度时按最高档处理，宁可吵不可热"""
+        if temp is None:
+            return len(self.speeds) - 1
+        for i, b in enumerate(self.effectiveBoundaries()):
+            if temp < b:
+                return i
+        return len(self.speeds) - 1
+
+    def speedAt(self, temp: Optional[int]) -> int:
+        return self.speeds[self.bandIndex(temp)]
+
+    def bandLowerEdge(self, index: int) -> int:
+        """第 index 档的下界温度（用于降档滞环判断）"""
+        if index <= 0:
+            return -1000
+        return self.effectiveBoundaries()[index - 1]
+
+    def levelRanges(self) -> List[Tuple[str, int]]:
+        """给界面/提示文本用的 (温度描述, 转速) 列表"""
+        eb = self.effectiveBoundaries()
+        out: List[Tuple[str, int]] = []
+        for i, spd in enumerate(self.speeds):
+            if i == 0:
+                desc = f"< {eb[0]}°C"
+            elif i == len(self.speeds) - 1:
+                desc = f"≥ {eb[-1]}°C"
+            else:
+                desc = f"{eb[i-1]}~{eb[i]}°C"
+            out.append((desc, spd))
+        return out
+
+    def describe(self) -> str:
+        return "　".join(f"{d}·{s}%" for d, s in self.levelRanges())
+
+    # ---------- 修改 ----------
+
+    def setBoundary(self, index: int, value: int) -> None:
+        if 0 <= index < len(self.boundaries):
+            self.boundaries[index] = int(value)
+            self.normalize()
+
+    def setSpeed(self, index: int, value: int) -> None:
+        if 0 <= index < len(self.speeds):
+            self.speeds[index] = int(value)
+            self.normalize()
+
+    def setBias(self, value: int) -> None:
+        self.bias = int(value)
+        self.normalize()
+
+    def reset(self) -> None:
+        self.boundaries = list(DEFAULT_BOUNDARIES)
+        self.speeds = list(DEFAULT_SPEEDS)
+        self.bias = 0
+        self.normalize()
+
+    def __eq__(self, other) -> bool:
+        if not isinstance(other, FanCurve):
+            return NotImplemented
+        return (self.boundaries == other.boundaries and
+                self.speeds == other.speeds and
+                self.bias == other.bias)
diff -ruN tcc-g15-master/src/GUI/HistoryChartWidget.py zh-src/src/GUI/HistoryChartWidget.py
--- tcc-g15-master/src/GUI/HistoryChartWidget.py	1970-01-01 09:00:00.000000000 +0900
+++ zh-src/src/GUI/HistoryChartWidget.py	2026-11-01 18:50:30.052102400 +0900
@@ -0,0 +1,159 @@
+"""
+温度 / 转速历史记录。
+
+拆成两部分：
+- HistoryBuffer：只管存数据，主界面每秒往里塞一个采样点，与界面是否可见无关
+- HistoryChartWidget：只负责画，从 buffer 里读
+
+这样设置窗口关掉再打开不会丢历史，也不用在对话框里定时采样。
+用 QPainter 直接画折线，不引 QtCharts（那会多十几 MB 打包体积）。
+"""
+
+import collections
+import csv
+import time
+from typing import Deque, List, Optional, Tuple
+
+from PySide6 import QtCore, QtGui, QtWidgets
+
+from GUI.AppColors import Colors
+
+Sample = Tuple[float, Optional[int], Optional[int], Optional[int], Optional[int]]
+
+
+class HistoryBuffer:
+    def __init__(self, capacity: int = 1800) -> None:
+        self.capacity = capacity
+        self.samples: Deque[Sample] = collections.deque(maxlen=capacity)
+
+    def add(self, gpuTemp: Optional[int], cpuTemp: Optional[int],
+            gpuRpm: Optional[int], cpuRpm: Optional[int]) -> None:
+        self.samples.append((time.time(), gpuTemp, cpuTemp, gpuRpm, cpuRpm))
+
+    def clear(self) -> None:
+        self.samples.clear()
+
+    def __len__(self) -> int:
+        return len(self.samples)
+
+    def exportCsv(self, path: str) -> int:
+        with open(path, "w", encoding="utf-8-sig", newline="") as f:
+            w = csv.writer(f)
+            w.writerow(["时间", "GPU温度(°C)", "CPU温度(°C)", "GPU转速(RPM)", "CPU转速(RPM)"])
+            for ts, gt, ct, gr, cr in self.samples:
+                w.writerow([time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(ts)),
+                            gt if gt is not None else "",
+                            ct if ct is not None else "",
+                            gr if gr is not None else "",
+                            cr if cr is not None else ""])
+        return len(self.samples)
+
+
+class HistoryChartWidget(QtWidgets.QWidget):
+    MARGIN_L, MARGIN_R, MARGIN_T, MARGIN_B = 42, 52, 22, 28
+    MAX_TEMP = 105
+    MAX_RPM = 6000
+
+    def __init__(self, buffer: HistoryBuffer,
+                 parent: Optional[QtWidgets.QWidget] = None) -> None:
+        super().__init__(parent)
+        self._buf = buffer
+        self.setMinimumSize(460, 190)
+        self.setSizePolicy(QtWidgets.QSizePolicy.Expanding, QtWidgets.QSizePolicy.Expanding)
+
+    def refresh(self) -> None:
+        self.update()
+
+    def _plotRect(self) -> QtCore.QRectF:
+        return QtCore.QRectF(
+            self.MARGIN_L, self.MARGIN_T,
+            max(1.0, self.width() - self.MARGIN_L - self.MARGIN_R),
+            max(1.0, self.height() - self.MARGIN_T - self.MARGIN_B),
+        )
+
+    def paintEvent(self, event) -> None:
+        p = QtGui.QPainter(self)
+        p.setRenderHint(QtGui.QPainter.Antialiasing)
+        r = self._plotRect()
+
+        p.fillRect(self.rect(), QtGui.QColor(Colors.DARK_GREY.value))
+        p.fillRect(r, QtGui.QColor('#171717'))
+
+        p.setFont(QtGui.QFont('Microsoft YaHei UI', 8))
+
+        gridPen = QtGui.QPen(QtGui.QColor('#2e2e2e'))
+        gridPen.setWidthF(1.0)
+        labelPen = QtGui.QPen(QtGui.QColor(Colors.GREY.value))
+
+        for t in range(0, self.MAX_TEMP + 1, 20):
+            y = r.bottom() - t / self.MAX_TEMP * r.height()
+            p.setPen(gridPen)
+            p.drawLine(QtCore.QPointF(r.left(), y), QtCore.QPointF(r.right(), y))
+            p.setPen(labelPen)
+            p.drawText(QtCore.QRectF(2, y - 8, self.MARGIN_L - 8, 16),
+                       QtCore.Qt.AlignRight | QtCore.Qt.AlignVCenter, f"{t}°")
+        for rpm in range(0, self.MAX_RPM + 1, 1500):
+            y = r.bottom() - rpm / self.MAX_RPM * r.height()
+            p.setPen(labelPen)
+            p.drawText(QtCore.QRectF(r.right() + 4, y - 8, self.MARGIN_R - 6, 16),
+                       QtCore.Qt.AlignLeft | QtCore.Qt.AlignVCenter, f"{rpm}")
+
+        samples = self._buf.samples
+        if len(samples) < 2:
+            p.setPen(labelPen)
+            p.drawText(r, QtCore.Qt.AlignCenter, "正在采集数据…")
+            p.end()
+            return
+
+        count = len(samples)
+
+        def xAt(index: int) -> float:
+            # 按当前已有样本数铺满宽度；缓冲区满了以后自然变成滑动窗口。
+            # 早期样本少时如果按 capacity 映射，曲线会挤在最右边看不出东西。
+            denom = max(count - 1, 1)
+            return r.left() + index / denom * r.width()
+
+        gpuColor = QtGui.QColor(Colors.GREEN.value)
+        cpuColor = QtGui.QColor(Colors.YELLOW.value)
+
+        def drawSeries(getter, color, maxVal, width, alpha, dashed=False):
+            col = QtGui.QColor(color)
+            col.setAlpha(alpha)
+            pen = QtGui.QPen(col)
+            pen.setWidthF(width)
+            if dashed:
+                pen.setStyle(QtCore.Qt.DashLine)
+            p.setPen(pen)
+            prev = None
+            for i, s in enumerate(samples):
+                v = getter(s)
+                if v is None:
+                    prev = None
+                    continue
+                cur = QtCore.QPointF(xAt(i), r.bottom() - v / maxVal * r.height())
+                if prev is not None:
+                    p.drawLine(prev, cur)
+                prev = cur
+
+        drawSeries(lambda s: s[3], gpuColor, self.MAX_RPM, 1.2, 110)
+        drawSeries(lambda s: s[4], cpuColor, self.MAX_RPM, 1.2, 110)
+        drawSeries(lambda s: s[1], gpuColor, self.MAX_TEMP, 2.0, 255)
+        drawSeries(lambda s: s[2], cpuColor, self.MAX_TEMP, 2.0, 255)
+
+        legend = [("GPU 温度", gpuColor, 255), ("CPU 温度", cpuColor, 255),
+                  ("GPU 转速", gpuColor, 110), ("CPU 转速", cpuColor, 110)]
+        x = r.left() + 8
+        for text, color, alpha in legend:
+            col = QtGui.QColor(color)
+            col.setAlpha(alpha)
+            p.setPen(QtGui.QPen(col, 2.0))
+            p.drawLine(QtCore.QPointF(x, r.top() - 12), QtCore.QPointF(x + 14, r.top() - 12))
+            p.setPen(QtGui.QPen(QtGui.QColor(Colors.WHITE.value)))
+            p.drawText(QtCore.QRectF(x + 18, r.top() - 20, 72, 16), QtCore.Qt.AlignLeft, text)
+            x += 88
+
+        span = int(samples[-1][0] - samples[0][0])
+        p.setPen(labelPen)
+        p.drawText(QtCore.QRectF(r.left(), r.bottom() + 6, r.width(), 16),
+                   QtCore.Qt.AlignCenter, f"最近 {span} 秒 · {count} 个采样")
+        p.end()
diff -ruN tcc-g15-master/src/GUI/QRadioButtonSet.py zh-src/src/GUI/QRadioButtonSet.py
--- tcc-g15-master/src/GUI/QRadioButtonSet.py	2026-10-23 18:53:08.323395700 +0900
